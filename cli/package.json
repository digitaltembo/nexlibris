{
  "name": "@nexlibris/cli",
  "version": "0.0.0",
  "private": true,
  "description": "nexlibris's tools on the command line: books' metadata, covers, conversion and metadata edits",
  "type": "module",
  "bin": {
    "nexlibris": "dist/main.js"
  },
